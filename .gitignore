prisma/*.db
prisma/*.db-journal

# ── مخرجات محلية / مؤقتة ──
scratchpad/
# حجر صحي لملفات اتشالت محليًا (أقفال git عالقة، وبقايا desktop/
# زي node_modules و.env.local). محتاجة تفضل بره git — `git add -A` بتاع
# scripts/ship.sh كان هيسحبها كلها.
_to_delete/
# desktop/ اتشال من الريبو في 7c22cc1 بناءً على طلب مازن، بس الفولدر لسه موجود
# على الجهاز. من غير السطر ده `git add -A` بيرجّعه للريبو تاني.
desktop/
# ملاحظة: deliverables/ و app/inspect.mjs مش متتبّعين حاليًا.
# لو عايزهم يتجاهلهم git، شيل التعليق عن السطرين دول:
# deliverables/
# app/inspect.mjs

# ── مفاتيح التوقيع والنشر (Apple / Google) ──
# المفاتيح الحقيقية متخزّنة **بره الريبو** في C:\Users\CM\.alassema-secrets\.
# القواعد دي خط دفاع تاني: `ship.sh` بيعمل `git add -A`، فأي مفتاح يتنسخ جوه
# الشجرة بالغلط كان هيتنشر على GitHub من غير ما حد ياخد باله — نفس الطريقة
# اللي اتسرب بيها api/.env جوه أرشيف في 2026-07-20.
*.p8
*.jks
*.keystore
*.mobileprovision
*.cer
*.certSigningRequest
google-play-service-account*.json
fcm-service-account*.json
