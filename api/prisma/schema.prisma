// Al Assema — Prisma schema
// Contract source of truth: ../backend-plan.md §3 + app/src/lib/apiTypes.ts
// Stack: Next.js API Routes · Supabase (Postgres) · Prisma 7

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  // Prisma 7: the connection URL lives in prisma.config.ts (for Migrate) and is
  // passed to the PrismaClient constructor via a driver adapter (see src/lib/prisma.ts).
  provider = "postgresql"
}

// Company visibility — controlled by admins. The public UI shows ACTIVE only.
enum CompanyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

// Values map (at the API boundary) to the frontend LeadStatus:
// "New" | "Contacted" | "In Progress" | "Completed" | "Cancelled"
enum LeadStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum UserRole {
  ADMIN
  PROVIDER
}

// Which identity provider a customer signed in through. Deliberately NOT added to
// UserRole: `User` is a STAFF account (admin / provider) with a password, and
// CustomerUser is a separate table entirely — see the comment on CustomerUser for
// why the two are not merged.
//
// APPLE is here from day one even though Google ships first: Apple's guideline 4.8
// makes Sign in with Apple mandatory for any app offering Google sign-in, so it is
// a certainty rather than a maybe, and having the value present means the second
// provider needs no migration.
enum IdentityProvider {
  GOOGLE
  APPLE
}

// Visitor messages submitted from a company page ("Report a problem" / suggestion
// / general inquiry). Maps (at the API boundary) to the frontend FeedbackType:
// "problem" | "suggestion" | "inquiry".
enum FeedbackType {
  PROBLEM
  SUGGESTION
  INQUIRY
}

// Moderation state for a portfolio project. Provider-submitted projects start
// PENDING and only appear publicly once an admin sets them APPROVED. Admin-created
// projects are APPROVED on creation.
enum ProjectStatus {
  PENDING
  APPROVED
  REJECTED
}

// Lifecycle of a single waiting-list entry. WAITING = just joined; NOTIFIED = the
// provider has reached out; CONVERTED = became a real request/customer; CANCELLED
// = withdrawn / no longer relevant. Contact happens off-platform (phone).
enum WaitlistStatus {
  WAITING
  NOTIFIED
  CONVERTED
  CANCELLED
}

// Phase 9 — whether a category's companies may run a priced Offering catalog.
// An enum, not a boolean: a future third mode (e.g. "provider's choice") adds a
// value without touching the shape of existing data, where a boolean would need
// a fresh migration if that need ever came up.
//   QUOTE_ONLY    — default for every existing category. No catalog; the
//                   customer requests and the price is agreed directly.
//   FIXED_CATALOG — companies in the category may publish priced Offerings.
enum CategoryPricingMode {
  QUOTE_ONLY
  FIXED_CATALOG
}

model Category {
  id              String              @id @default(uuid())
  slug            String              @unique
  label           String // the frontend calls it label, not name
  description     String              @db.Text
  icon            String // Material Symbols icon name
  cover           String? // ApiCategory.cover — category cover image
  isActive        Boolean             @default(true)
  // Default QUOTE_ONLY on every existing row — zero behavior change on deploy.
  // The real enforcement lives in offerings.service.ts (assertCatalogEnabled),
  // not just in what the admin UI shows — see that file for why.
  pricingMode     CategoryPricingMode @default(QUOTE_ONLY)
  // Optional per-page SEO overrides (admin-set). Null → frontend falls back to
  // the label/description-derived defaults.
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  companies CompanyCategory[]

  // count in the frontend = number of ACTIVE companies, computed live (not stored).

  @@index([slug])
  @@index([isActive])
}

// A company may belong to multiple categories/services (e.g. a company that does
// both Interior Finishing and Landscaping) — this is the many-to-many junction.
// Every company has EXACTLY ONE isPrimary=true row at all times, enforced by a
// partial unique index (company_category_one_primary, hand-written SQL — Prisma's
// schema language can't express a WHERE clause on an index; same technique as
// change_request_one_pending below). The primary category is what every existing
// single-value display spot (company card badge, featured-project card, profile
// page, search result label) shows — see serialize.ts companyScalars. Category
// PAGE listings and the Offerings pricing-catalog gate, by contrast, consider
// every linked category, not just the primary (see companies.service.ts buildWhere
// and offerings.service.ts assertCatalogEnabled).
model CompanyCategory {
  id         String   @id @default(uuid())
  companyId  String
  categoryId String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([companyId, categoryId])
  // Serves category → companies (public listing, live counts).
  @@index([categoryId])
  // Serves company → categories (editors, catalog gate, primary lookup).
  @@index([companyId])
}

model Company {
  id                  String        @id @default(uuid())
  slug                String        @unique
  name                String
  tagline             String // short one-liner
  about               String        @db.Text
  logo                String
  cover               String // large cover image
  services            String[] // Postgres text[]
  gallery             String[] // gallery image URLs
  badges              String[] // ["Licensed", "Award-Winning"]
  phone               String
  location            String
  yearsExperience     Int           @default(0)
  responseTime        String // "within 2 hours"
  verifiedSince       String // "2021"
  completedProjects   Int           @default(0) // manual admin number (!= projects.length)
  // aggregate cache — recomputed from Review on any change, UNLESS ratingOverridden
  // is true, in which case an admin set rating/reviewCount manually and the review
  // recompute leaves them alone (see reviews.service recompute). Clearing the flag
  // recomputes from real reviews again.
  rating              Float         @default(0)
  reviewCount         Int           @default(0)
  ratingOverridden    Boolean       @default(false)
  featured            Boolean       @default(true)
  verified            Boolean       @default(false)
  status              CompanyStatus @default(ACTIVE)
  // Availability ("busy") — provider- and admin-controlled. When busy is true the
  // public profile swaps its "Request Service" CTA for "Join the waiting list".
  // busyUntil is an optional auto-reopen instant: a company is EFFECTIVELY busy only
  // while busy=true AND (busyUntil is null OR busyUntil is in the future), so once
  // the date passes every read reports it available again (no cron needed — see
  // serialize.ts isEffectivelyBusy). busyNote is an optional customer-facing reason.
  busy                Boolean       @default(false)
  busyUntil           DateTime?
  busyNote            String?
  // internal contact fields for notifications — NOT returned in the public payload
  email               String?
  whatsapp            String?
  // DEPRECATED — superseded by the telegramChats relation below, which lets one
  // company have several linked Telegram accounts (owner + staff) instead of a
  // single one that each new link silently overwrote. Kept on the model for one
  // release so a rollback has its data; nothing reads it any more. Drop it in a
  // follow-up migration once telegramChats is proven in production.
  telegramChatId      String?
  // Single-use deep-link token behind the dashboard's "Connect Telegram" button.
  // The provider opens t.me/<bot>?start=<token>, so the link is proven by the
  // token rather than by matching a shared phone. Cleared the moment it is
  // redeemed; ignored past its expiry. Unique so a token identifies one company.
  telegramLinkToken   String?       @unique
  telegramLinkExpires DateTime?
  // Optional per-page SEO overrides (admin-set). Null → frontend falls back to
  // the name/tagline-derived defaults.
  metaTitle           String?
  metaDescription     String?
  // Al Asima's commission %, business-control-center only. Null = use the
  // platform default (AppSetting "default_commission_percent") — every
  // existing row stays null on deploy, zero behavior change, same pattern as
  // CategoryPricingMode's default. Set only when a specific provider needs a
  // different rate than the platform default (see finance.service.ts).
  commissionPercent   Decimal?      @db.Decimal(5, 2)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  categories     CompanyCategory[]
  projects       Project[]
  reviews        Review[]
  leads          Lead[]
  users          User[]
  feedbacks      Feedback[]
  waitlist       WaitlistEntry[]
  changeRequests ChangeRequest[]
  offerings      Offering[]
  bundleRules    BundleRule[]
  busyWindows    BusyWindow[]
  conversations  Conversation[]
  telegramChats  CompanyTelegramChat[]
  transactions   Transaction[]

  @@index([slug])
  @@index([status])
  @@index([featured])
}

// One Telegram account receiving a company's alerts. A company may link several
// (owner plus staff) — every row here gets every lead and chat notification.
//
// This replaces the old single Company.telegramChatId, where linking a second
// phone silently overwrote the first and the person who had been getting alerts
// simply stopped, with nothing in the UI to explain why.
//
// chatId is unique per company, not globally: one Telegram account legitimately
// belongs to two companies (an owner running two businesses), but linking the
// same account to the same company twice would just double every message.
model CompanyTelegramChat {
  id        String   @id @default(uuid())
  companyId String
  // Telegram's numeric chat id, stored as text (it exceeds 32 bits and we only
  // ever pass it back to the Bot API verbatim).
  chatId    String
  // Display label so the dashboard can show WHICH account is linked — otherwise
  // a provider looking at three rows of digits can't tell which one to remove.
  // Filled from the Telegram profile at link time; may be null for rows migrated
  // from the old column, where we never captured a name.
  label     String?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, chatId])
  @@index([companyId])
}

// A customer who joined a company's waiting list while it was busy. Stores only
// name + phone (contact is off-platform, matching the lead-generation model). The
// provider/admin dashboards list these and move them through WaitlistStatus.
model WaitlistEntry {
  id        String         @id @default(uuid())
  companyId String
  name      String
  phone     String
  service   String? // optionally the service they're waiting for
  note      String?        @db.Text
  status    WaitlistStatus @default(WAITING)
  createdAt DateTime       @default(now()) // returned as epoch ms in the API
  // Set exactly once, when an accept (status -> CONVERTED) creates the real Lead
  // this entry became — see waitlist.service.ts convertToLead. @unique makes the
  // conversion idempotent (a second accept reuses this instead of creating another
  // Lead) and lets the API/UI drop this entry from the CRM pipeline view once it
  // has a Lead of its own to appear as instead. SetNull (not Cascade) so deleting
  // the resulting Lead doesn't also delete this history row.
  convertedLeadId String? @unique

  company       Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  convertedLead Lead?   @relation(fields: [convertedLeadId], references: [id], onDelete: SetNull)

  @@index([companyId])
  // Serves the provider/admin waitlist list: WHERE companyId=? [AND status=?]
  // ORDER BY createdAt DESC — filter + sort from one index.
  @@index([companyId, status, createdAt])
}

model Project {
  id          String        @id @default(uuid())
  companyId   String
  title       String
  img         String // matches ApiProject.img + data.ts
  description String        @db.Text
  year        String // display string e.g. "2024"
  sortOrder   Int           @default(0)
  // Curated for the homepage "Featured Projects" showcase (admin-set).
  featured    Boolean       @default(false)
  // Moderation state. New rows default to PENDING (provider submissions); admin
  // creations are set APPROVED in the service. Only APPROVED show publicly.
  status      ProjectStatus @default(PENDING)
  createdAt   DateTime      @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([featured])
  @@index([status])
}

model Review {
  id        String   @id @default(uuid())
  companyId String
  // The completed lead this review came from, for verified customer reviews; null
  // for curated/seeded admin reviews. UNIQUE → enforces one review per lead at the
  // DB level (the one-time customer review invariant). Postgres allows many NULLs,
  // so curated reviews don't collide. See reviews.service submitFromLead.
  leadId    String?  @unique
  author    String // matches ApiReview.author
  avatar    String // initial letter as fallback
  rating    Int // 1..5
  text      String   @db.Text
  date      String // "March 2024" (display string)
  district  String // matches ApiReview.district
  // true = submitted by a real customer on a COMPLETED lead (shows a "Verified"
  // badge). false = curated/seeded by an admin. See reviews.service submitFromLead.
  verified  Boolean  @default(false)
  // Moderation gate. Customer submissions start unapproved (hidden + excluded from
  // the rating aggregate) until an admin approves them. Admin-curated reviews are
  // created approved. New rows default false; existing rows backfilled to true.
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Deleting a lead keeps its (verified) review but unlinks it (SetNull). Deleting
  // the company cascades both via companyId, so there's no conflict.
  lead    Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([approved])
  // Serves the hot public/company read: WHERE companyId=? AND approved=true
  // ORDER BY createdAt DESC — filter + sort from one index.
  @@index([companyId, approved, createdAt])
}

model Lead {
  id            String     @id @default(uuid())
  refNumber     String     @unique // AA-YYYYMMDD-XXXX — generated server-side
  // High-entropy secret (generated at creation) that gates public status tracking
  // and the one-time review, replacing the guessable phone number. Nullable so
  // leads created before this column existed fall back to phone-tail matching.
  trackingToken String?
  companyId     String
  service       String // requested service (text)
  customerName  String // ApiLead.name
  phone         String
  district      String
  budget        String
  description   String     @db.Text
  status        LeadStatus @default(NEW)
  // Set once the customer leaves a (verified) review for this lead — gates the
  // one-time review flow so a completed request can be reviewed exactly once.
  reviewedAt    DateTime?
  createdAt     DateTime   @default(now()) // returned as epoch ms (Number) in the API
  updatedAt     DateTime   @updatedAt

  // Estimate captured at submission time. NOT recomputed on read: if a provider
  // raises a price next month, what the customer was quoted must not change.
  estimatedMin    Int?
  estimatedMax    Int?
  discountPercent Int?    @default(0)
  // True when at least one item is quoted after inspection, so the UI can show
  // "+ items quoted on site" instead of implying the estimate is the whole job.
  hasOnInspection Boolean @default(false)
  // Which internal Client (phone-deduplicated) this lead's customer resolves
  // to — see the Client model. Nullable + SetNull: a lead must never become
  // unreadable because its Client row was touched, same non-destructive
  // pattern as Review.leadId / WaitlistEntry.convertedLeadId.
  clientId        String?
  // The signed-in CustomerUser who submitted this, when there was one.
  //
  // Nullable and SetNull, like clientId above and for the same reason: every
  // lead created before accounts existed has none, and a lead must never become
  // unreadable because the account that owned it was removed. The provider's
  // copy of the request is business data; the account is a way to reach it.
  //
  // Distinct from clientId: `Client` is the phone-deduplicated grouping derived
  // from what was typed into the form, and it exists whether or not anyone ever
  // signed in. This is the account that actually owns the request.
  customerId      String?

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer     CustomerUser? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // companySlug + companyName are returned derived from this relation.
  // The (at most one) verified review submitted for this completed lead.
  review       Review?
  items        LeadItem[]
  conversation Conversation?
  // Back-relation for WaitlistEntry.convertedLeadId — the waitlist entry this lead
  // was accepted from, if any. Absent for a lead created the normal way.
  waitlistEntry WaitlistEntry?
  // Provider's final-price completion + the client's price verification, if the
  // provider has marked this lead done. See LeadCompletion.
  completion    LeadCompletion?
  client        Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  transactions  Transaction[]

  @@index([companyId])
  @@index([status])
  @@index([createdAt])
  @@index([clientId])
  // Serves "my requests" for a signed-in customer: WHERE customerId=?
  // ORDER BY createdAt DESC — filter + sort from one index, same shape as the
  // companyId one below.
  @@index([customerId, createdAt])
  // Serves the provider/admin lead lists: WHERE companyId=? [AND status=?]
  // ORDER BY createdAt DESC — filter + sort from one index.
  @@index([companyId, status, createdAt])
}

// Client's response to the provider's reported final amount. Only meaningful once
// a LeadCompletion row exists — its mere existence means "submitted"; this enum
// tracks what happens next. See LeadCompletion.
enum LeadVerificationStatus {
  PENDING // provider submitted, client hasn't responded yet
  CONFIRMED // client agrees with the provider's amount
  DISCREPANCY // client reported a different amount
}

// One-time provider "mark as completed" record for a Lead: the final amount +
// optional additional work, and (once the client responds) the price
// verification outcome. Creating this row is paired with flipping Lead.status to
// COMPLETED (see leadCompletion.service.submitCompletion) — that's the ONE
// existing status the review flow already gates on (reviews.service
// submitFromLead), so no new status/state-machine was added to LeadStatus.
//
// `leadId @unique` is the DB-level guard against submitting completion twice; the
// PENDING -> non-PENDING transition (claimed via a conditional updateMany, same
// pattern as Lead.reviewedAt in reviews.service) is the guard against verifying
// twice.
model LeadCompletion {
  id     String @id @default(uuid())
  leadId String @unique

  // What the provider reported.
  providerAmount             Int // base/final service amount, EGP
  additionalWorkDescription  String? @db.Text
  additionalWorkAmount       Int?
  notes                      String? @db.Text
  // Supabase Storage URLs (provider/upload, "projects" bucket) — optional photos.
  attachments                String[] @default([])
  submittedAt                DateTime @default(now())

  // What the client reported back. clientAmount/discrepancyNote/verifiedAt are
  // only set once verificationStatus leaves PENDING.
  verificationStatus LeadVerificationStatus @default(PENDING)
  clientAmount       Int?
  discrepancyNote    String? @db.Text
  verifiedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([verificationStatus])
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(PROVIDER)
  companyId    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  // Self-service Telegram link, same mechanism as Company's (see telegram.service
  // createAdminLinkUrl/linkAdminByToken). Lets any ADMIN user connect their own
  // Telegram from the dashboard instead of the whole platform sharing one chat id
  // hardcoded in TELEGRAM_ADMIN_CHAT_ID. PROVIDER rows never populate these.
  telegramChatId      String?
  telegramLinkToken   String?   @unique
  telegramLinkExpires DateTime?
  // Business Control Center (desktop app) access, additive to `role` — see
  // withPermission.ts. Empty array = no desktop access at all, regardless of
  // role. Deliberately NOT folded into UserRole: the desktop app is a second,
  // more sensitive surface (real financial data) than the web admin
  // dashboard, so access is opt-in per user rather than implied by ADMIN.
  // Values are DesktopPermission strings, e.g. "finance:write" — validated in
  // application code (validation/users.ts), not as a DB enum, so adding a
  // module later needs no migration.
  desktopPermissions  String[]  @default([])

  company           Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull)
  pushSubscriptions PushSubscription[]
  pushDevices       PushDevice[]

  @@index([email])
  @@index([companyId])
}

// Web Push subscription for a user's browser/device. One row per device (a user
// may enable notifications on phone + laptop). `endpoint` is the push service URL
// and is globally unique. Deleted automatically when the push service reports the
// subscription is gone (404/410) — see push.service. Cascades with the user.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String // client public key (base64url) for payload encryption
  auth      String // client auth secret (base64url)
  userAgent String? // for the user to identify which device this is
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Visitor-submitted platform testimonials shown on the homepage. New submissions
// are held (visible=false) for admin moderation before they appear publicly.
model SiteReview {
  id        String   @id @default(uuid())
  name      String
  district  String
  rating    Int // 1..5
  text      String   @db.Text
  visible   Boolean  @default(false)
  createdAt DateTime @default(now()) // returned as epoch ms in the API

  @@index([visible])
  @@index([createdAt])
}

// Visitor-submitted messages tied to a specific company ("Report a problem" /
// suggestion / inquiry from the company page). Surfaced to admins for triage;
// isRead marks whether an admin has seen it.
model Feedback {
  id        String       @id @default(uuid())
  companyId String
  type      FeedbackType @default(PROBLEM)
  name      String?
  phone     String?
  message   String       @db.Text
  isRead    Boolean      @default(false)
  createdAt DateTime     @default(now()) // returned as epoch ms in the API

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([isRead])
  @@index([createdAt])
}

// Simple key/value store for global toggles (e.g. site_reviews_enabled).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Append-only audit trail of sensitive/destructive admin actions (deletes, status
// and role/active changes, account creation). Recorded fail-open so a logging
// failure never breaks the action. actorEmail is denormalized so the record stays
// meaningful even if the actor account is later deleted.
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actorEmail String
  action     String // e.g. "company.delete", "company.status", "user.update"
  entity     String // e.g. "Company", "User", "Lead"
  entityId   String
  meta       String? // optional JSON string with extra context (e.g. new status)
  createdAt  DateTime @default(now()) // returned as epoch ms in the API

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([actorId])
}

// ── Change requests (provider edits awaiting admin approval) ──────────────────
// DELIBERATELY GENERIC. Feature B (Offerings, tiers, bundle rules) reuses this
// exact model and the same admin review screen rather than growing a second
// approval system — two approval systems in one product means two behaviours,
// two UIs, and a confused admin.
//
// No CREATE operation: a row is always created as a draft first (isPublished =
// false, from Feature B onward), so an id exists before any request is filed.
// PUBLISH means "make this existing draft public for the first time".

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ChangeEntity {
  COMPANY
  OFFERING
  OFFERING_TIER
  BUNDLE_RULE
}

enum ChangeOperation {
  PUBLISH
  UPDATE
  DELETE
}

model ChangeRequest {
  id            String              @id @default(uuid())
  companyId     String // owning company — drives filtering and permissions
  entity        ChangeEntity
  // Required, never null. For COMPANY this equals companyId. Being non-nullable is
  // what makes the partial unique index below actually work: Postgres treats every
  // NULL as distinct, so a nullable column would silently allow duplicates.
  entityId      String
  operation     ChangeOperation     @default(UPDATE)
  submittedById String // User.id of the provider who filed it
  changes       Json // only the changed fields: { field: newValue }
  snapshot      Json // the same fields' values at submit time (diff + conflict detection)
  note          String? // provider's message to the admin
  status        ChangeRequestStatus @default(PENDING)
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNote    String? // rejection reason — shown to the provider
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // NOTE: "one PENDING per (entity, entityId)" is enforced by a PARTIAL unique
  // index, which Prisma's schema language cannot express. It lives as raw SQL in
  // the migration: change_request_one_pending. Do not try to model it here.

  @@index([status, createdAt])
  @@index([companyId, status])
  @@index([entity, entityId, status])
}

// ── Offerings (per-company priced services / products) ───────────────────────
// Draft/published model. The row's OWN state decides the write path:
//   isPublished = false → draft the provider owns → direct writes
//   isPublished = true  → public content → every edit goes through ChangeRequest
// There is deliberately NO review status on the row itself: if there were, a
// published offering would drop out of the public profile the moment its owner
// fixed a typo, which is content deletion dressed up as moderation.

enum OfferingKind {
  SERVICE
  PRODUCT
}

enum PricingModel {
  FIXED
  RANGE
  PER_UNIT
  ON_INSPECTION
}

// A closed set, not free text. "م²" / "متر مربع" / "m2" typed by three different
// providers are the same unit to a human and three different units to a GROUP BY,
// which silently breaks the category price reference.
enum PriceUnit {
  SQM
  METER
  PIECE
  DOOR
  WINDOW
  ROOM
  APARTMENT
  HOUR
  DAY
  JOB
}

model Offering {
  id                  String       @id @default(uuid())
  companyId           String
  name                String
  description         String?      @db.Text
  kind                OfferingKind @default(SERVICE)
  pricingModel        PricingModel @default(RANGE)
  // Egyptian pounds, whole numbers — no piastres anywhere in the product, and no
  // `currency` column: it would be a dead column today and every comparison
  // already assumes one currency. Multi-currency is its own migration.
  priceMin            Int?
  priceMax            Int?
  unit                PriceUnit? // required when pricingModel = PER_UNIT
  minQty              Int? // e.g. a 50 m² minimum
  image               String?
  note                String? // "price excludes materials"
  // sortOrder + isActive are the ONLY provider-writable fields on a published
  // row that skip review (see the Feature B exception): they are display order
  // and operational visibility, and change no content or price.
  sortOrder           Int          @default(0)
  isActive            Boolean      @default(true)
  isPublished         Boolean      @default(false)
  // Set only by the backfill. Gives the migration an idempotency key without
  // imposing a permanent @@unique on `name`, which would stop a company ever
  // having two offerings called "Installation" under different headings.
  migratedFromService String?
  priceUpdatedAt      DateTime? // drives "prices updated N days ago"
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tiers   OfferingTier[]
  items   LeadItem[]

  @@unique([companyId, migratedFromService])
  @@index([companyId, isPublished, isActive, sortOrder])
}

// Quantity bands: "one room" / "2–3 rooms" / "whole apartment".
model OfferingTier {
  id         String @id @default(uuid())
  offeringId String
  label      String
  qtyMin     Int?
  qtyMax     Int?
  priceMin   Int?
  priceMax   Int?
  sortOrder  Int    @default(0)
  // A tier carries its own PRICE, and a tier price overrides the offering's for
  // that line (see leadItems.service). Without this flag a provider could add a
  // tier to an already-published offering and it went straight onto the public
  // profile — the one write path in Feature B that skipped review entirely.
  //
  // Same contract as Offering.isPublished: false = a draft only the provider
  // sees, and the generic PUBLISH change-request flips it. Defaults to false so
  // a newly written row is closed until reviewed; the migration backfills
  // existing rows to true, since they are already live and must stay visible.
  isPublished Boolean @default(false)

  offering Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@index([offeringId, sortOrder])
}

// Bundle discount — consumed by Feature C (multi-item requests), defined here so
// the pricing tables all land in one migration.
model BundleRule {
  id              String   @id @default(uuid())
  companyId       String
  label           String?
  minItems        Int // applies once the basket has at least this many items
  discountPercent Int // 1..50, enforced in validation
  isActive        Boolean  @default(true)
  isPublished     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, isActive])
}

// One line on a multi-item request.
//
// Every price here is a SNAPSHOT taken when the request was submitted. The row
// deliberately duplicates data that could be read back through `offering` —
// because that is exactly the point: if the provider raises a price, or renames
// or deletes the offering next month, what this customer was quoted must not
// change. A request is a record of an agreement, not a live view of a price list.
model LeadItem {
  id           String       @id @default(uuid())
  leadId       String
  // Null once the offering is deleted (SetNull). The snapshot fields below are
  // what keep the line readable after that.
  offeringId   String?
  nameSnapshot String
  tierLabel    String?
  qty          Int          @default(1)
  pricingModel PricingModel
  unitPriceMin Int?
  unitPriceMax Int?
  lineMin      Int? // qty * unitPriceMin
  lineMax      Int?

  lead     Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  offering Offering? @relation(fields: [offeringId], references: [id], onDelete: SetNull)

  @@index([leadId])
}

// ── Scheduled busy windows ───────────────────────────────────────────────────
// Adds scheduling ON TOP of the existing manual busy/busyUntil switch — it does
// not replace it. A company is busy if EITHER says so.
//
// No cron, by design. "Busy right now" is derived at read time from these rows,
// exactly like busyUntil already works, so a window opens and closes on its own
// with nothing scheduled to run and nothing to fall behind.
model BusyWindow {
  id             String    @id @default(uuid())
  companyId      String
  startsAt       DateTime
  // null = open-ended, until someone closes it. At most ONE of these per company
  // (see busyWindows.service): an open window overlaps every future window
  // forever, so allowing two would make scheduling impossible.
  endsAt         DateTime?
  note           String? // "Eid holiday" · "large project"
  // Set when an admin created it. Providers can see but not edit or delete those
  // — otherwise an admin marking a company unavailable could be undone by the
  // company itself.
  createdByAdmin Boolean   @default(false)
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Serves the hot read: WHERE companyId IN (...) AND (endsAt IS NULL OR endsAt > now)
  // ORDER BY startsAt — filter + sort from one index.
  @@index([companyId, startsAt])
}

// ── Chat (customer ↔ provider, with admin oversight) ─────────────────────────
// One thread per request. The customer reaches it with the request's reference
// number plus its tracking token — no account, matching the existing tracking
// gate.

enum MessageSender {
  CUSTOMER
  PROVIDER
  ADMIN
}

model Conversation {
  // @unique on leadId is what makes getOrCreateConversation safe to upsert
  // concurrently: two simultaneous opens can't create two threads.
  leadId         String    @unique
  id             String    @id @default(uuid())
  companyId      String
  lastMessageAt  DateTime?
  // Unread counters per side. Denormalized on purpose — the provider's thread
  // list and the customer's request list both need a badge, and counting
  // messages per conversation on every read would be a query per row.
  customerUnread Int       @default(0)
  providerUnread Int       @default(0)
  closed         Boolean   @default(false)
  createdAt      DateTime  @default(now())

  lead     Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([companyId, lastMessageAt])
  @@index([lastMessageAt])
}

model Message {
  id             String        @id @default(uuid())
  conversationId String
  sender         MessageSender
  senderUserId   String? // provider/admin only; customers have no account
  body           String        @db.Text
  attachment     String?
  // Admin moderation. Hidden messages stay in the table and stay visible to
  // admins — removing the row would destroy the record of what was said.
  hidden         Boolean       @default(false)
  createdAt      DateTime      @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Serves the hot poll: WHERE conversationId=? AND createdAt > ? ORDER BY createdAt.
  @@index([conversationId, createdAt])
}

// ── Business Control Center: Clients, Finance ────────────────────────────────
// Added for the desktop "AL ASIMA BUSINESS CONTROL CENTER" app. Reuses every
// existing entity (Lead, Company, LeadCompletion) rather than forking a second
// pricing/lead system — see the delivered architecture/gap-analysis doc for
// the full rationale. Decisions baked in here (already confirmed with Mazen):
//   - Commission recognizes on CLIENT VERIFICATION (LeadCompletion.
//     verificationStatus leaving PENDING), computed on clientAmount even when
//     disputed (see TransactionStatus.DISPUTED) — leadCompletion.service.verify.
//   - One platform-wide default commission % (AppSetting key
//     "default_commission_percent"), with Company.commissionPercent as a
//     per-company override for later.
//   - Client is a lightweight phone-deduplication record, NOT a customer
//     login/account — the no-login lead/review/verify trust model is untouched.

// A person who has submitted one or more Leads, deduplicated by phone. Purely
// an internal aggregation record for the desktop "Clients & CRM" screen
// (retention rate, lifetime value, roster) — customers still have no account
// and still interact via the existing ref+token/phone-gated flows. Upserted
// from leads.service.createLeadRecord on every new lead (create-or-refresh by
// phone); backfilled once for existing leads via a one-time migration script.
// A CUSTOMER's login account — the person who submits requests. Signed in through
// Google (and later Apple); there is no password here at all.
//
// ── Why a separate table from `User` ─────────────────────────────────────────
// `User` is a staff account: it has a passwordHash, a UserRole, a companyId, and
// desktopPermissions, and every existing guard (withAuth → getAuthUser, withRole,
// withPermission) resolves against it. Folding customers in would mean every one
// of those guards suddenly sees rows that must never satisfy them, and the
// protection would rest on a role check being present everywhere rather than on
// the lookup simply not finding the row. Two tables make "a customer token can
// never authorize a staff route" a structural fact instead of a policy.
//
// ── Why this is NOT the same thing as `Client` ───────────────────────────────
// `Client` is a phone-deduplicated grouping of leads, derived from what people
// typed into the request form — it exists whether or not that person ever signs
// in. CustomerUser is a login identity. One may end up pointing at the other once
// a customer claims a past request, but they answer different questions and are
// keyed on different things (phone vs. email).
model CustomerUser {
  id String @id @default(uuid())
  // Display/merge handle, not the login key — see CustomerIdentity.subject for
  // that. Unique so a second provider can be linked to an existing account when
  // it asserts the SAME verified address.
  //
  // Note this is NOT guaranteed to be a reachable inbox: Apple's "Hide My Email"
  // returns a per-app relay address. Fine as a key; never assume mail sent here
  // is read by a human who recognizes it.
  email         String  @unique
  name          String
  avatarUrl     String?
  // Set only for accounts that registered with a password. NULL means "this
  // account signs in through a provider only" — and verifyPasswordSafe turns
  // that into a failed login that still costs one bcrypt compare, so a
  // Google-only account is indistinguishable from a wrong password by timing.
  passwordHash  String?
  // Did the PROVIDER assert this address is verified? Load-bearing for account
  // linking: auto-attaching a new provider to an existing account on an
  // unverified address is an account-takeover path (sign up with a provider that
  // lets you claim any address, inherit the victim's requests). Linking is
  // allowed only when this is true — see the customerAuth service.
  emailVerified Boolean @default(false)
  // ── Email verification for PASSWORD registrations ──────────────────────────
  // A password account is INERT until this is cleared by a valid verification
  // click — login refuses an unverified account outright. That is not politeness
  // about deliverability; it is what closes an account-takeover path:
  //
  //   Without it, anyone can register victim@gmail.com with a password they
  //   choose. When the real owner later signs in with Google, the linking rule
  //   in customerAuth.service sees a matching address, links the two, and the
  //   attacker's password now opens the victim's account and every request in it.
  //
  // Requiring verification makes the planted account useless on its own, and the
  // Google path refuses to inherit an unverified one (see claimUnverifiedAccount).
  //
  // The token is stored HASHED, for the same reason passwords are: a database
  // read (backup, log, injected SELECT) otherwise hands over a working key to
  // every pending account. sha256 rather than bcrypt is right here — the input is
  // 32 bytes of CSPRNG output, so there is no low-entropy guess to slow down.
  emailVerifyTokenHash String?   @unique
  emailVerifyExpires   DateTime?
  // Same kill-switch semantics as User.isActive: token verification re-checks it
  // on every request, so flipping it false revokes access without waiting for
  // the JWT to expire.
  isActive      Boolean @default(true)

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  identities CustomerIdentity[]
  sessions   CustomerSession[]
  devices    PushDevice[]
  leads      Lead[]
  // No @@index([email]) — @unique above already creates one, and a second index
  // on the same column only costs write throughput. (`User` above carries that
  // duplication; not worth a migration to undo there, but not worth copying.)
}

// One row per (provider, provider's user id) pair a CustomerUser can sign in with.
//
// A join table rather than `googleSub` / `appleSub` columns on CustomerUser, for
// three reasons that all showed up in the plan:
//   1. The SAME person signing in with Google on Android and Apple on iPhone is
//      the expected duplicate-account case. Linking a second provider to one
//      account is the mitigation, and it is a row insert here.
//   2. `subject` — not email — is the stable login key. A Google account's email
//      can change; the `sub` claim never does. Looking up by (provider, subject)
//      keeps sign-in correct through an email change.
//   3. A third provider later is a new enum value, not a schema change here.
model CustomerIdentity {
  id         String           @id @default(uuid())
  customerId String
  provider   IdentityProvider
  // The provider's immutable user id: the `sub` claim of the verified ID token.
  // Opaque — never parse it, never show it.
  subject    String
  createdAt  DateTime         @default(now())

  customer CustomerUser @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // THE login lookup, and the guard against one provider identity being attached
  // to two different accounts.
  @@unique([provider, subject])
  @@index([customerId])
}

// A long-lived sign-in on one device, for the MOBILE apps.
//
// ── Why this exists ──────────────────────────────────────────────────────────
// The access token lives for JWT_TTL (a day). On the website that is invisible:
// the tab is open, the cookie is there, and a re-login now and then costs a
// password manager click. On a phone it means being signed out every morning,
// which is the fastest way to get an app deleted.
//
// So a device also holds a REFRESH token — long-lived, stored in the platform
// keystore, exchanged for a fresh access token whenever the old one expires.
// This table is what makes those revocable, which a stateless JWT never is:
// "sign out this device" and "sign out everywhere" both become an UPDATE here.
//
// ── Web deliberately gets none of this ───────────────────────────────────────
// A row is created only when a client asks for one (by sending `device` at
// sign-in). The website doesn't, and shouldn't: it has an httpOnly cookie that
// JavaScript cannot read, and handing it a refresh token would mean putting a
// 60-day credential into localStorage where XSS can reach it. Strictly worse
// than what it already has.
model CustomerSession {
  id         String @id @default(uuid())
  customerId String

  // sha256 of the refresh token — never the token itself. Same reasoning as the
  // email-verification token: a database read must not yield working keys. sha256
  // rather than bcrypt because the input is 32 bytes of CSPRNG output, so there
  // is no low-entropy guess for a slow hash to defend against.
  tokenHash String @unique

  // ── Rotation, and the retry that naive rotation breaks ─────────────────────
  // Every refresh issues a NEW token and retires the old one, so a stolen token
  // is useful only until the real device next refreshes. But mobile networks
  // drop responses: the server rotates, the reply never arrives, and the app
  // retries with a token the server has already retired. Rotating without a
  // grace window signs that user out for a dropped packet.
  //
  // So the previous hash is kept. Presented within the grace window it returns
  // the CURRENT token again (an idempotent retry). Presented AFTER it, the only
  // explanation left is that someone else kept a copy — see reuse detection in
  // customerSession.service.
  previousTokenHash String?   @unique
  previousUsableTo  DateTime?

  // Shown on the "your devices" screen. Client-supplied and therefore untrusted:
  // a label for a human, never something authorization reads.
  deviceName String?
  platform   String? // "ios" | "android"

  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  // Set instead of deleting the row: a revoked session is evidence, and a
  // presented-after-revocation token is worth being able to see in the log.
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  customer CustomerUser @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  // Serves the periodic sweep of dead rows.
  @@index([expiresAt])
}

// A NATIVE push target — one install of one of the mobile apps.
//
// ── Why not just extend PushSubscription ────────────────────────────────────
// That table is Web Push: an endpoint URL plus two encryption keys, delivered
// by signing a VAPID request to the browser's own push service. Expo is a
// single opaque token posted to Expo's HTTP API, which fans out to APNs and
// FCM. Different shape, different transport, different failure vocabulary (a
// dead Web Push endpoint is a 404/410; a dead Expo token is a
// "DeviceNotRegistered" receipt).
//
// Folding both into one table would mean three nullable columns, a kind flag,
// and every existing query on PushSubscription becoming ambiguous — for a
// notification path that currently works and that a provider depends on to hear
// about a new lead. A second table leaves that one untouched.
//
// ── Why the owner is two nullable columns ───────────────────────────────────
// A device belongs to a STAFF user (the Business app) or to a CUSTOMER (the
// client app) — never both, and the two live in different tables with no shared
// parent. Exactly one is set; the register routes are what enforce it, since
// each one can only ever populate its own side.
model PushDevice {
  id String @id @default(uuid())

  // Expo push token — "ExponentPushToken[…]". Opaque: never parsed, only sent.
  token      String  @unique
  platform   String // "ios" | "android"
  deviceName String?

  userId     String?
  customerId String?

  // Bumped on every registration so a token that stops being refreshed can be
  // swept later. Expo tokens can change on reinstall, and the old one lingers
  // until its first failed send.
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user     User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer CustomerUser? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([customerId])
}

model Client {
  id          String   @id @default(uuid())
  // Normalized via the same libphonenumber-js convention already used
  // elsewhere in the codebase (api/app phone.ts) — NOT the raw user-typed
  // string, so "01001234567" and "+201001234567" dedupe to one Client.
  phone       String   @unique
  // Most-recent Lead.customerName seen for this phone — a display label, not
  // an identity claim (the same person may type their name differently across
  // requests; the phone is the actual identity key).
  name        String
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leads Lead[]

  @@index([phone])
  @@index([lastSeenAt])
}

enum FinancialAccountType {
  CASH
  BANK
  // Conceptual clearing account for money owed to/from providers — not a real
  // bank account. Optional to use; Transaction.accountId is nullable.
  PROVIDER_PAYABLE
}

// A small, admin-managed list of "where the money is" — a bank account, a cash
// box, etc. Deliberately NOT a bank-feed integration; just a label transactions
// can be tagged with for the Cash Position / Expenses-by-account views.
model FinancialAccount {
  id        String               @id @default(uuid())
  name      String
  type      FinancialAccountType
  isActive  Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  transactions Transaction[]

  @@index([isActive])
}

enum TransactionType {
  // Al Asima's recognized commission on a client-verified completed lead.
  COMMISSION_INCOME
  EXPENSE
  // Manual correction (rare) — always audited (see AuditLog), never a way to
  // route around the COMMISSION_INCOME/EXPENSE distinction.
  ADJUSTMENT
}

enum TransactionStatus {
  // Recognized but not yet collected — accrual. Drives "Outstanding Revenue".
  PENDING
  // Client reported a discrepancy; commission is still recognized on their
  // reported clientAmount, but marked so Finance doesn't read it as settled.
  // Moved to PENDING/COLLECTED/VOID once an admin resolves the discrepancy.
  DISPUTED
  // Cash actually received/paid.
  COLLECTED
  // Reversed. Kept for the audit trail — never hard-deleted, matching the
  // rest of this schema's soft-flag philosophy (Review.approved, Project.
  // status, etc. — nothing here is ever actually removed from the table).
  VOID
}

// A small, admin-managed taxonomy for expenses/income ("Operations & Cloud",
// "Personnel", ...) — powers the "Expenses by Category" card. `kind` scopes a
// category to one TransactionType so the picker only offers relevant options.
model TransactionCategory {
  id       String          @id @default(uuid())
  name     String          @unique
  kind     TransactionType
  isActive Boolean         @default(true)

  transactions Transaction[]

  @@index([kind, isActive])
}

// THE financial ledger. One typed table, not a separate income/expenses/
// balance-field trio — see the delivered architecture doc §3.3/§6 for why.
// Balance-type numbers (Outstanding, Collected, Cash Position) are always
// SUM(amount) WHERE ... computed on read from this table, never stored.
model Transaction {
  id          String             @id @default(uuid())
  type        TransactionType
  status      TransactionStatus  @default(PENDING)
  // EGP, whole pounds — matches the existing convention (Lead/Offering prices
  // are Int, no piastres, no currency column anywhere in this schema).
  amount      Int
  accountId   String?
  categoryId  String?
  // The business event this transaction is about. Nullable because manual
  // expenses have no lead.
  leadId      String?
  // The provider this transaction is about, if any (set on every
  // COMMISSION_INCOME row; usually null on EXPENSE).
  companyId   String?
  note        String?  @db.Text
  // Supabase Storage URLs — same pattern as LeadCompletion.attachments.
  attachments String[] @default([])
  occurredAt  DateTime @default(now())
  // Who recorded this — an admin User.id for manual entries, null for
  // system-generated COMMISSION_INCOME rows (there is no human actor for
  // those). Deliberately a plain denormalized id with NO Prisma relation, same
  // convention as AuditLog.actorId — this table must never fail to write
  // because a User row was deleted.
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account  FinancialAccount?    @relation(fields: [accountId], references: [id])
  category TransactionCategory? @relation(fields: [categoryId], references: [id])
  lead     Lead?                @relation(fields: [leadId], references: [id])
  company  Company?             @relation(fields: [companyId], references: [id])

  @@index([type, status])
  @@index([leadId])
  @@index([companyId])
  @@index([occurredAt])
  @@index([accountId])
  @@index([categoryId])
}
