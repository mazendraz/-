# Integration-test environment. Copy to .env.test (gitignored). Points the suite at
# the local throwaway Postgres from docker-compose.yml — NOT prod. The setup guard
# refuses any non-local DB, so this file is what keeps `npm run test:integration`
# from touching your real database.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/alassema?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/alassema?schema=public"
JWT_SECRET="test-secret-for-vitest"
