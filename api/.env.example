# ── Database (Supabase Postgres) ──────────────────────────────────────────────
# Serverful (VPS / long-running Node process): use the Session pooler for BOTH
# DATABASE_URL and DIRECT_URL. The direct "db.[PROJECT-REF].supabase.co" host is
# IPv6-only, which most VPS hosts can't reach — the session pooler (port 5432)
# supports IPv4 and behaves like a direct connection (safe for `prisma migrate`).
# Get the exact host from Settings → Database → Session pooler — host prefix is
# usually "aws-0-" but can be "aws-1-" for some projects/regions.
# User must be "postgres.[PROJECT-REF]" (not just "postgres") with the pooler.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"
# Path to the Supabase CA certificate (Dashboard → Settings → Database → SSL →
# download). When set, the DB connection verifies the server certificate against
# it (full MITM protection). STRONGLY recommended in production. Leave empty in
# local dev (falls back to encrypted-but-unverified TLS; a warning is logged in
# production so it can't ship unnoticed).
DATABASE_SSL_CA_PATH=""

# ── Supabase (Auth + Storage) ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=""
# Token lifetime (e.g. "1h", "30m", "7d"). Defaults to 1d. The token is delivered
# as an httpOnly session cookie (SameSite=Strict, Secure in prod) that JS cannot
# read — so XSS can't steal it — and logout clears it server-side. It still CANNOT
# be revoked before expiry, so keep this SHORT in production. To force-revoke a
# session immediately, deactivate the user (isActive=false); getAuthUser rejects
# inactive users on the next request. The cookie's max-age tracks this value.
JWT_TTL="1d"

# ── First admin (npm run create-admin) ────────────────────────────────────────
# Used ONLY by `npm run create-admin` to bootstrap the first ADMIN login. The
# catalog seed does not create any admin. Set these as one-off env vars when
# running the command; do not keep real credentials committed.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Site Admin"

# ── Public site ───────────────────────────────────────────────────────────────
# Canonical FRONTEND origin (no trailing slash) — used to build absolute URLs in
# the dynamic sitemap (/api/sitemap). Set to your live site domain.
PUBLIC_SITE_URL="https://alassema.com"

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API. Leave empty in local
# dev to reflect any origin. In production set this to the site origin(s).
CORS_ALLOWED_ORIGINS=""
# Optional shared gate matching the frontend's VITE_API_KEY.
API_KEY=""
# Trusted reverse-proxy hops in front of the app (each appends one
# X-Forwarded-For entry). Caddy alone = 1. Add a CDN/load-balancer → set to 2.
# Used by the rate limiter to find the real client IP (rateLimit.ts).
TRUSTED_PROXY_HOPS="1"

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Set BOTH to use Upstash Redis so limits hold across restarts/instances. REQUIRED
# in production unless RATE_LIMIT_ALLOW_INMEMORY=1 — the in-memory limiter is
# per-process and resets per cold lambda, so it provides ~no protection on
# serverless/multi-instance deploys (the app refuses to boot to prevent that).
# From the Upstash console → your database → "REST API".
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Set to "1" ONLY when running a single long-lived instance (e.g. PM2 fork on a
# VPS), where the in-memory limiter is correct. Leave empty for serverless.
RATE_LIMIT_ALLOW_INMEMORY=""
# Global circuit breakers on public lead submits (POST /api/leads), INDEPENDENT
# of the per-IP limit. They cap total lead volume so a botnet of many distinct
# IPs (each under the per-IP limit) can't flood the pipeline. Per 60s window.
# Site-wide cap across ALL companies; raise for high legitimate traffic.
LEADS_SITE_RATE_LIMIT="100"
# Per-company cap (keyed by slug); catches a flood aimed at one company.
LEADS_COMPANY_RATE_LIMIT="20"
# Max FAILED login attempts per account (keyed by email) within a 15-min window,
# on top of the per-IP login limit. Counts only failures — a correct password is
# never blocked — so it slows distributed credential stuffing against one account
# without ever locking out the real user.
LOGIN_ACCOUNT_MAX_FAILURES="10"

# ── CAPTCHA (optional: bot protection on public submit forms) ─────────────────
# Set ONE secret to require a CAPTCHA on lead/site-review/review submits. When
# unset, verification is skipped (the honeypot + rate limit still apply).
# IMPORTANT: enabling a secret REQUIRES the frontend to render the matching
# widget and send its token (VITE_TURNSTILE_SITE_KEY / VITE_RECAPTCHA_SITE_KEY),
# or every submit is rejected. Turnstile is preferred when both are set.
TURNSTILE_SECRET_KEY=""
RECAPTCHA_SECRET_KEY=""
# By default CAPTCHA "fails open" if the verifier is unreachable (an outage won't
# block real users). Set to "1" to "fail closed" (reject instead) on high-value
# endpoints where blocking abuse outweighs the rare verifier outage.
CAPTCHA_FAIL_CLOSED=""

# ── Error reporting (optional) ────────────────────────────────────────────────
# Set a Sentry DSN to ship unhandled 500s to Sentry (over the HTTP envelope API,
# no SDK). Errors are always logged regardless.
SENTRY_DSN=""

# ── Email notifications (optional) ────────────────────────────────────────────
# Without RESEND_API_KEY, lead emails to providers are skipped (lead creation
# still succeeds). RESEND_FROM must be a verified sender on your Resend account —
# and until a DOMAIN is verified, Resend refuses every recipient except the
# account owner. See the "Email delivery" note at the bottom of this file; it is
# the difference between customer signup working and silently not.
RESEND_API_KEY=""
RESEND_FROM="Al Assema <onboarding@resend.dev>"

# ── Web Push notifications (optional) ─────────────────────────────────────────
# Browser/desktop push notifications to providers + admins on every new lead, even
# when the dashboard is closed. Without these keys, push is skipped (lead creation
# still succeeds; email above is independent). Generate ONE keypair and reuse it
# forever (rotating it invalidates every existing subscription):
#   npx web-push generate-vapid-keys
# VAPID_SUBJECT must be a mailto: or https: URL identifying you to the push service.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@alassema.com"

# ── Telegram notifications (optional, free) ───────────────────────────────────
# Instant Telegram message to the owner/admin on every new lead, via the Telegram
# Bot API. Without a bot token, Telegram is skipped (lead creation still succeeds;
# email & push above are independent). Setup:
#   1. In Telegram, open @BotFather → /newbot → copy the token here.
#   2. Open your new bot, press Start, then get your numeric chat id (open
#      https://api.telegram.org/bot<TOKEN>/getUpdates and read result[].message
#      .chat.id, or message @userinfobot). Put it in TELEGRAM_ADMIN_CHAT_ID.
# Providers get a Telegram alert too once they link the bot: they open it, tap
# "share my number", and we match that phone to their Company (phone/whatsapp) and
# store the chat id. That linking runs through the webhook below.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""
# The bot's @username (with or without the @), e.g. "AlAssemaLeadsBot". Needed to
# build the t.me deep link behind the dashboard's "Connect Telegram" button. Without
# it that button is hidden entirely and providers can only link via the phone-share
# fallback. Find it in @BotFather → /mybots, or GET /bot<TOKEN>/getMe → result.username.
TELEGRAM_BOT_USERNAME=""
# Secret that authenticates Telegram's calls to POST /api/telegram/webhook. Pick any
# long random string, then register it when setting the webhook:
#   curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://YOUR_API_HOST/api/telegram/webhook&secret_token=<THIS_VALUE>"
# Telegram echoes it back in the x-telegram-bot-api-secret-token header on every
# call; the route rejects anything that doesn't match. Without it, the webhook is
# ignored (provider self-linking is disabled; admin alerts still work).
TELEGRAM_WEBHOOK_SECRET=""

# ── Customer sign-in with Google ─────────────────────────────────────────────
# Comma-separated list of EVERY Google OAuth client id allowed to sign in here.
# There will be more than one: a Web client for the site, plus an iOS client and
# an Android client, each issued its own id by Google. A token is minted for
# whichever client asked for it, so all of them must be listed or that platform
# cannot sign in.
#
# These are PUBLIC values — they ship inside the mobile app binary and the web
# bundle, and are meant to be. The client SECRET is not used at all: this backend
# verifies ID tokens against Google's public keys (see googleIdentity.service),
# which is the flow that needs no secret. Do not add one here.
#
# Unset → POST /api/v1/auth/google answers 400 "not available" and the apps fall
# back cleanly instead of erroring.
# Find them in Google Cloud Console → Google Auth Platform → Clients.
GOOGLE_CLIENT_IDS=""

# ── Mobile apps: version gate ────────────────────────────────────────────────
# Read by GET /api/v1/app-version, which every app build calls on launch.
#
# A published app cannot be fixed by deploying — whatever build someone
# installed keeps running until they choose to update. These are the one
# server-side lever over that, and they take effect on restart, not on deploy.
#
# APP_MIN_VERSION blocks: builds below it show an update screen and stop.
# Reserve it for a broken contract or a security fix — it is the most
# disruptive thing you can do to someone mid-task.
# APP_LATEST_VERSION only suggests, dismissibly.
# Unset means "let everything through", which is the safe default.
APP_MIN_VERSION=""
APP_LATEST_VERSION=""
APP_IOS_URL=""
APP_ANDROID_URL=""
# Optional line shown on the update screen, e.g. "Sign-in has changed — please
# update to continue."
APP_UPDATE_MESSAGE=""

# ── Native push (Expo) ───────────────────────────────────────────────────────
# Optional. Expo accepts unauthenticated sends, but an access token ties them to
# your project, which is what makes rate limits and delivery receipts
# attributable. Expo dashboard → Account settings → Access tokens.
# Unset → native push still sends; you just lose that attribution.
EXPO_ACCESS_TOKEN=""
