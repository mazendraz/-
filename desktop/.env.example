# AL ASIMA Business Control Center — desktop app environment.
# Copy to .env.local and fill in for your environment. .env.local is
# gitignored and never committed.

# ── API ──────────────────────────────────────────────────────────────────────
# Absolute base URL of the Al Asima backend REST API (the api/ Next.js app),
# no trailing slash, INCLUDING the /api suffix. Must be absolute (not "/api"
# like app/.env.example) — a Tauri window is never same-origin with the API,
# so a bare path would resolve against tauri://localhost instead.
#
# This origin must also be allow-listed in
# src-tauri/capabilities/default.json's http:default scope, or every request
# is rejected before it leaves the app (see that file's comments).
#
#   Local dev (api/ running via `npm run dev`): http://localhost:3000/api
#   Production: https://<your-deployed-api-domain>/api
VITE_API_URL=http://localhost:3000/api
