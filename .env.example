# Al Assema — Environment Variables
# Copy this file to .env.local and fill in the values for your environment.
# .env.local is gitignored and never committed.

# ── API ────────────────────────────────────────────────────────────────────────
# Base URL of the Al Assema backend REST API (no trailing slash).
# Leave blank to run entirely on localStorage / mock data (default for local dev).
VITE_API_URL=

# Optional static API key forwarded as X-Api-Key on every request.
VITE_API_KEY=
