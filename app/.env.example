# Al Assema — Environment Variables
# Copy this file to .env.local and fill in the values for your environment.
# .env.local is gitignored and never committed. This template must stay free of
# real secrets — it is committed to git.

# ── API ────────────────────────────────────────────────────────────────────────
# Base URL of the Al Assema backend REST API (the api/ Next.js app), no trailing
# slash. The backend serves routes under /api, so include that suffix.
#
# RECOMMENDED: use the SAME-ORIGIN path "/api". In dev, Vite proxies /api → the
# backend (see vite.config.ts); in prod, Caddy serves /api on the same origin.
# Same-origin is REQUIRED for the httpOnly session cookie to flow (cross-origin
# would need SameSite=None + credentialed CORS). Override the dev backend target
# with VITE_DEV_API_TARGET if the backend isn't on http://localhost:3000.
#   Recommended (dev + prod): /api
#   Cross-origin (advanced):  https://your-backend-host/api
# Leave blank to run entirely on localStorage / mock data.
VITE_API_URL=/api

# Optional static API key forwarded as X-Api-Key on every request. Only needed if
# the backend sets API_KEY; this must match that secret. NOT a Supabase key.
VITE_API_KEY=

# ── CAPTCHA (optional: bot protection on public forms) ──────────────────────────
# Cloudflare Turnstile site key. When set, the lead / review / feedback /
# site-review forms render a Turnstile widget and send its token. Leave blank to
# disable (forms submit with no widget — honeypot + rate limit still apply).
# MUST pair with the backend's TURNSTILE_SECRET_KEY, or submits are rejected.
VITE_TURNSTILE_SITE_KEY=

# ── Customer sign-in with Google ───────────────────────────────────────────────
# The WEB OAuth client id from Google Cloud Console → Google Auth Platform →
# Clients. Public by design (it ships in the JS bundle) — this is not a secret,
# and the client SECRET is never used by this flow at all.
#
# Must also be listed in the backend's GOOGLE_CLIENT_IDS, or every sign-in is
# rejected on the audience check.
#
# In Google Cloud Console, the client's "Authorized JavaScript origins" must
# include every origin the site is served from — http://localhost:5173 for dev
# and the production domain. Google refuses to render the button on an origin
# that isn't listed, with an error only visible in the browser console.
#
# Leave blank to hide customer sign-in entirely.
VITE_GOOGLE_CLIENT_ID=
