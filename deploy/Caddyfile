# Al Assema — Caddy reverse proxy for a single-domain VPS deployment.
# Caddy gets a free HTTPS certificate automatically (Let's Encrypt).
#
# Architecture (one domain, NO CORS needed because same-origin):
#   https://your-domain.com/         → static frontend (app/dist, SPA fallback)
#   https://your-domain.com/api/*    → Next.js backend on localhost:3000
#
# Because the frontend and API share an origin, build the frontend with
#   VITE_API_URL=/api   (already wired in deploy/deploy.sh)
# and you can leave CORS_ALLOWED_ORIGINS empty in api/.env.
#
# Install Caddy: https://caddyserver.com/docs/install   (Ubuntu: apt install caddy)
# Put this file at /etc/caddy/Caddyfile, edit the domain + root path, then:
#   sudo caddy fmt --overwrite /etc/caddy/Caddyfile
#   sudo systemctl reload caddy

your-domain.com {
	encode zstd gzip

	# API → Next.js backend (PM2 on :3000)
	handle /api/* {
		# Reject oversized request bodies at the edge — the outer layer of the
		# body-size guard (the app also caps public JSON submits at 64KB; see
		# bodyLimit.ts). Stops a bot forcing the backend to buffer/parse huge
		# payloads. Set just above the app's upload caps (upload.service.ts):
		# 5MB for images, 50MB for gallery videos — raise both together if you
		# need bigger uploads.
		request_body {
			max_size 55MB
		}

		reverse_proxy localhost:3000 {
			# Strip any client-supplied X-Forwarded-For and re-set it from the real
			# peer, so the app can't be tricked into trusting a spoofed client IP
			# (the per-IP rate limiter reads the rightmost hop — see rateLimit.ts).
			# Keep TRUSTED_PROXY_HOPS=1 in api/.env to match this single hop.
			header_up X-Forwarded-For {remote_host}
		}
	}

	# Everything else → static SPA with client-side routing fallback
	handle {
		root * /var/www/alassema/dist

		# ── Security headers ─────────────────────────────────────────────────
		# These cover the origin the BROWSER actually loads: the HTML document,
		# the JS bundle, the service worker, and the origin the session cookie
		# belongs to. next.config.ts sets an equivalent set, but Next only serves
		# /api/* here — so without this block the whole frontend shipped bare.
		#
		# HSTS applies per-ORIGIN, so setting it here also covers /api/* on this
		# same host. Caddy v2 does NOT add it automatically (it only does the
		# HTTP→HTTPS redirect), which is why it has to be explicit.
		header {
			# 2 years. Remove `preload` if you are not certain about every
			# subdomain — submitting to the preload list is hard to undo.
			Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
			# Stop the browser guessing a type an uploaded file did not declare.
			X-Content-Type-Options "nosniff"
			# Clickjacking on the admin/provider dashboards. Modern browsers use
			# frame-ancestors in the CSP below; this covers the older ones.
			X-Frame-Options "DENY"
			# The lead tracking page carries ?ref= and ?token= in its URL. Without
			# this, both leak in the Referer header to every external resource the
			# page loads (Google Fonts today, anything added tomorrow).
			Referrer-Policy "no-referrer"
			Permissions-Policy "camera=(), microphone=(), geolocation=()"
			Cross-Origin-Opener-Policy "same-origin"
			Cross-Origin-Resource-Policy "same-origin"
			# Don't advertise the server product/version.
			-Server
		}

		# ── Content-Security-Policy (ENFORCED) ───────────────────────────────
		# Was Content-Security-Policy-Report-Only from the day it was written,
		# which blocks nothing. Enforced as of the 2026-08-10 security audit
		# (finding M-01).
		#
		# Verified safe to enforce before flipping it: the BUILT app/dist/index.html
		# contains exactly two scripts, both external (/locale-init.js and the
		# hashed /assets bundle) — no inline <script>, so `script-src 'self'` with
		# no 'unsafe-inline' holds.
		#
		# Notes (same-origin deploy, so connect-src 'self' covers the API):
		#   • script-src 'self' — no 'unsafe-inline', so injected inline <script>
		#     is actually blocked. This is the line that does the work.
		#   • style-src allows 'unsafe-inline' — React sets inline style=""
		#     attributes; style injection is low-risk. Fonts CSS from googleapis.
		#   • img-src / media-src allow Supabase Storage + data: URIs.
		#   • worker-src / manifest-src fall back to default-src 'self', which
		#     covers /sw.js and /manifest.webmanifest.
		#   • frame-src/…cloudflare.com is only needed when Turnstile is on.
		#
		# ── accounts.google.com — customer sign-in (added with the Google flow) ──
		# Google Identity Services cannot be bundled; it loads from Google's origin
		# and needs FOUR allowances, and missing any ONE of them breaks sign-in in
		# a different, confusing way:
		#   script-src  — the /gsi/client library itself. Without it: nothing at
		#                 all renders and the console shows a CSP violation.
		#   frame-src   — GIS puts the account chooser in an iframe. Without it:
		#                 the button renders, the click does nothing.
		#   connect-src — GIS's own XHR back to Google. Without it: the button
		#                 renders, the chooser opens, no credential ever arrives.
		#   style-src   — GIS injects a stylesheet for the button. Without it: the
		#                 button appears unstyled and the layout breaks.
		# img-src also gains *.googleusercontent.com, which is where every Google
		# profile picture is served from (CustomerUser.avatarUrl).
		#
		# NONE of this is verifiable locally: Vite serves no CSP, so sign-in works
		# perfectly in dev whether these are here or not. Test on staging.
		#
		# ⚠ IF IMAGES DISAPPEAR after enforcing: a company logo/cover/gallery URL
		# points at a host outside 'self' and *.supabase.co. The admin validator
		# (validation/shared.ts imageRef) historically accepted ANY https URL. Find
		# them, don't widen the policy:
		#   SELECT slug, logo, cover FROM "Company"
		#   WHERE logo  !~ '^(/|https://[a-z0-9-]+\.supabase\.co)'
		#      OR cover !~ '^(/|https://[a-z0-9-]+\.supabase\.co)';
		#
		# ROLLBACK (one word): rename the header below back to
		# `Content-Security-Policy-Report-Only` and `systemctl reload caddy`.
		# ── fonts.googleapis.com / fonts.gstatic.com are GONE from this policy ──
		# The web fonts are self-hosted as of the reliability audit (app/src/fonts.css
		# + app/public/fonts) precisely so a third-party host can no longer stall the
		# first paint. Removing the allowances is the other half of that: it makes the
		# policy state the truth, and it means a future re-added <link> fails loudly at
		# review time instead of quietly reintroducing the outage.
		#
		# `font-src 'self'` still covers the WOFF2 files — they are same-origin now.
		# `style-src` keeps 'unsafe-inline' (React sets inline style="" attributes) and
		# the GIS stylesheet, which is not ours to host.
		#
		# ⚠ IF TEXT SUDDENLY RENDERS IN A SYSTEM FONT after deploying this: a
		# @font-face url in app/src/fonts.css is pointing off-origin. Fix the file,
		# don't widen the policy back.
		header Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; font-src 'self'; img-src 'self' data: https://*.supabase.co https://*.googleusercontent.com; media-src 'self' https://*.supabase.co; connect-src 'self' https://accounts.google.com/gsi/; frame-src https://challenges.cloudflare.com https://accounts.google.com/gsi/; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"

		# ── Deep-link association files ──────────────────────────────────────
		# `apple-app-site-association` has NO file extension, so Caddy guesses
		# application/octet-stream — and iOS silently ignores an association file
		# that isn't application/json. No error, no log line, no diagnostic:
		# universal links just quietly open the browser instead of the app.
		#
		# The try_files line below would also be fatal on its own: a missing
		# match falls through to /index.html, so a typo'd path answers 200 with
		# HTML instead of 404, and iOS reads that as a malformed file. Matching
		# the exact path first keeps both files out of the SPA fallback.
		#
		# See app/public/.well-known/README.md for the placeholders that must be
		# filled in before either app ships.
		@aasa path /.well-known/apple-app-site-association
		header @aasa Content-Type application/json

		# ── Cache-Control ────────────────────────────────────────────────────
		# There was NONE of this until the 2026-08-26 reliability audit, and the
		# absence was not neutral. With no explicit freshness directive a browser
		# falls back to HEURISTIC caching (RFC 9111 §4.2.2) — commonly 10% of the
		# time since Last-Modified. An index.html a week old therefore gets
		# roughly seventeen hours of "fresh" with NO revalidation, so a returning
		# visitor is handed the previous release's HTML, which references
		# content-hashed chunks that the deploy has already replaced. The result
		# is a ChunkLoadError and the CrashScreen — "works after a hard refresh".
		#
		# The two rules below are a pair and only work together:
		#
		#   • HTML must ALWAYS revalidate. `no-cache` does not mean "don't
		#     store" — it means "store it, but check before reusing it". With
		#     Caddy's Etag that check is a 304 with an empty body, so this costs
		#     one round trip and no bandwidth. This is the rule that guarantees a
		#     reload picks up the new build.
		#
		#   • Hashed assets can be cached FOREVER, and should be. The filename
		#     changes whenever the bytes change, so there is no such thing as a
		#     stale hit — `immutable` additionally tells the browser not to
		#     revalidate even on an explicit reload, which is what makes a hard
		#     refresh cheap instead of re-downloading the whole bundle.
		#
		# The other half of this fix lives in deploy/_build.sh, which no longer
		# deletes the previous build's chunks. Headers alone would not help a tab
		# asking for a file that is no longer on disk.
		#
		# ── Why the second rule is "everything else" and not "the HTML" ───────
		# The obvious spelling is `@html path / /index.html`. Don't use it. A
		# deep link like /companies/foo is REWRITTEN to /index.html by try_files
		# below, and whether the `header` matcher sees the original path or the
		# rewritten one depends on where `header` sits in Caddy's directive
		# order — which is not something this file should be betting the fix on.
		# `not path /assets/*` is true either way, before or after any rewrite.
		#
		# The cost of the broader rule is that the unhashed files from
		# app/public (favicon, logo, manifest, sw.js, locale-init.js, /img/*)
		# also revalidate on each load. Those are conditional requests answered
		# with an empty 304 thanks to Caddy's Etag, and two of them — sw.js and
		# manifest.webmanifest — are ones you actively WANT picked up promptly.
		# Accepted deliberately; if /img/* ever shows up in a performance
		# profile, give it its own `max-age` rule rather than narrowing this one.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		@revalidate not path /assets/*
		header @revalidate Cache-Control "no-cache"

		# ── SPA fallback ─────────────────────────────────────────────────────
		# `try_files {path} /index.html` is what makes client-side routing work:
		# /companies/foo is not a file, so it serves the app shell and the router
		# takes over. That is correct for ROUTES and actively harmful for ASSETS.
		#
		# A missing /assets/*.js otherwise answers `200 text/html` (the shell)
		# instead of 404. The browser refuses to execute HTML as a module, so the
		# failure still happens — the retry in app/src/router.tsx still fires —
		# but it arrives as an opaque "failed to fetch dynamically imported
		# module" next to a 200 in the network panel, which is about as
		# misleading as a diagnostic can get.
		#
		# Attaching the matcher to try_files (rather than splitting this into
		# nested handle blocks) keeps the routing shape identical to what was
		# here before: for /assets/* the rewrite is simply skipped and
		# file_server answers directly, which means a real 404 for a real
		# missing file.
		@spaRoute not path /assets/*
		try_files @spaRoute {path} /index.html
		file_server
	}
}
